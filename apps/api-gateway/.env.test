# ==========================================
# CONFIGURACIÓN DEL SERVICIO PARA TESTS
# ==========================================
PORT=3002
NODE_ENV=test

# ==========================================
# URL DE SERVICIOS PARA TESTS (comunicación interna)
# ==========================================
# En tests, los servicios corren en localhost
AUTH_SERVICE_URL=http://localhost:3003
ATTENDANCE_SERVICE_URL=http://localhost:3001

# ==========================================
# SEGURIDAD JWT PARA TESTS
# ==========================================
JWT_SECRET=test-jwt-secret-key-for-testing-only

# ==========================================
# CONFIGURACIÓN CORS PARA TESTS
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003

# ==========================================
# CONFIGURACIÓN DE LOGGING PARA TESTS
# ==========================================
# Nivel de log mínimo para tests
LOG_LEVEL=error