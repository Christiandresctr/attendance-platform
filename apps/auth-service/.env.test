# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS PARA TESTS
# ==========================================
# Usamos SQLite en memoria para tests rápidos
DB_TYPE=sqlite
DB_DATABASE=:memory:
DATABASE_URL=:memory:

# ==========================================
# CONFIGURACIÓN DEL SERVICIO PARA TESTS
# ==========================================
PORT=3003
NODE_ENV=test

# ==========================================
# SEGURIDAD JWT PARA TESTS
# ==========================================
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h

# ==========================================
# CONFIGURACIÓN CORS PARA TESTS
# ==========================================
ALLOWED_ORIGINS=http://localhost:3002,http://api-gateway:3002

# ==========================================
# CONFIGURACIÓN DE RATE LIMITING
# ==========================================
# Deshabilitar rate limiting para tests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=1000

# ==========================================
# CONFIGURACIÓN DE LOGGING PARA TESTS
# ==========================================
# Nivel de log mínimo para tests
LOG_LEVEL=error